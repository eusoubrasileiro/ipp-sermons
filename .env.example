# Copy to .env and fill in. Never commit .env.

# Single LLM credential — embeddings and reranking both go through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Postgres. In production the host is the compose service name.
DATABASE_URL=postgresql://ipp:CHANGEME@db:5432/ipp_sermons
POSTGRES_USER=ipp
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=ipp_sermons

# Where the indexer reads metadata.csv and transcripts/ from.
CORPUS_DIR=./data

# Set to 1 to skip reranking. Search still works; ranking is just RRF-only.
# RERANK_DISABLED=1

# Pin both images to one commit at deploy time.
# IMAGE_TAG=latest
