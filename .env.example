# Copy to .env and fill in. Never commit .env.

# Single LLM credential — embeddings and reranking both go through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Postgres. In production the host is the compose service name.
DATABASE_URL=postgresql://ipp:CHANGEME@db:5432/ipp_sermons
POSTGRES_USER=ipp
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=ipp_sermons

# Where the indexer reads metadata.csv and transcripts/ from.
CORPUS_DIR=./data

# Set to 1 to skip reranking. Search still works; ranking is just RRF-only.
# RERANK_DISABLED=1

# Pin both images to one commit at deploy time.
# IMAGE_TAG=latest

# --- corpus update pipeline (tools/corpus-update) ---

# Where audio and intermediate transcripts live. Never inside the repo: this
# grows by ~170 MB per sermon and must not reach git or the VPS.
# IPP_WORK_DIR=/mnt/Data/ipp-sermons-work

# Optional. Only fills the sp_suffix_url column, which is a link on the site and
# nothing else; without it new rows just have no Spotify link. Discovery and
# transcription need no credentials at all.
# The secret committed in the archive notebooks and sermons/do_the_scrape.md is
# public and must be rotated -- do not reuse it here.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
