# Prisma and esbuild need postinstall scripts to fetch their engines/binaries.
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=esbuild

# `pnpm deploy` prunes dev dependencies for the runtime image. pnpm 10 requires
# this opt-in for workspaces that are not injected.
force-legacy-deploy=true
