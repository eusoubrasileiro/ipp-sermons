#!/usr/bin/env sh
# Heavy gate. Runs once before `git push` — the last check before the branch
# leaves the machine.
#
# Adapted from the standards template, which shipped stages this repo has not
# wired yet: `pnpm exec tsc --noEmit` finds no root tsconfig (workspaces own
# their own, so typechecking must recurse), and show-review-log /
# quality-gate / security-review all live in a `scripts/` directory that does
# not exist here. Referencing them made the hook unpassable rather than strict.
# Restore them individually as they are actually brought in.
set -e
pnpm typecheck
pnpm lint
pnpm test
