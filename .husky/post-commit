#!/usr/bin/env sh
# The review-log backfill used to run here. It rewrote the newest "(staged)"
# entry to HEAD -- but the reviewer runs at pre-push, so post-commit had always
# already passed and each entry was claimed by the NEXT commit instead. The
# reviewer now stamps the real SHA at write time (reviewedCommit()), which
# leaves nothing here to correct.
node scripts/print-quality-delta.mjs 2>/dev/null || true
