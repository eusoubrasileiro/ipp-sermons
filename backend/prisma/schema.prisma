// Schema for the IPP sermon search corpus.
//
// Two tables: one row per sermon (the legacy metadata.csv), and one row per
// retrievable chunk. Chunks carry their own embedding so search returns the
// passage that matched, not the whole 6,400-word transcript.
//
// The parts Prisma cannot express — the pt_unaccent text-search config, the
// generated tsvector column, the HNSW/GIN indexes and the hybrid_search()
// function — live in prisma/sql/001_hybrid_search.sql and are applied after
// `prisma db push`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]

  // "native" covers local dev. The debian targets are for the container:
  // Prisma cannot always detect the libssl version in a slim image and then
  // guesses wrong, so ship both engines rather than let it pick.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, unaccent]
}

model Sermon {
  id String @id

  title       String
  /// Preacher, normalized against the 28 canonical names in preacher_names.txt.
  artist      String
  date        DateTime  @db.Date
  durationStr String    @map("duration_str")
  durationSec Int       @map("duration_sec")

  /// URL suffixes, not full URLs — matches the legacy columns. The app builds
  /// the playable link; the 77 GB of audio is never hosted here.
  scSuffixUrl String? @map("sc_suffix_url")
  spSuffixUrl String? @map("sp_suffix_url")

  /// wav2vec forced-alignment quality (0-100). The corpus is filtered to > 50,
  /// the same cutoff the GPU pipeline used.
  score        Float
  words        Int
  sentences    Int
  /// Delivery pace, surfaced in the UI by the old frontend.
  wordsMin     Float @map("words_min")
  sentencesMin Float @map("sentences_min")

  /// Browse facets, derived offline from the title and committed under
  /// data/facets/. They live on the row rather than in a join table because
  /// each is single-valued, which lets hybrid_search() filter on them without
  /// widening its candidate CTEs any further.
  ///
  /// These MUST stay in this schema even though 002_facets.sql also creates
  /// them: anything Prisma does not know about, it deletes as drift on the
  /// next `db push` — the same trap that eats the `fts` column, except here it
  /// would take the derived data with it.
  serviceType  String? @map("service_type")
  seriesSlug   String? @map("series_slug")
  seriesPart   Int?    @map("series_part")
  /// Title with the leading date and event prefix stripped, for display.
  displayTitle String? @map("display_title")

  /// Whether `spSuffixUrl` still resolves. The podcast feed is capped at 500
  /// items, so aggregators delist sermons that age out of it — the id stays
  /// valid while the episode 404s. Derived from the feed, not from the date.
  spotifyAlive Boolean @default(true) @map("spotify_alive")

  series     Series?            @relation(fields: [seriesSlug], references: [slug], onDelete: SetNull)
  chunks     SermonChunk[]
  scriptures SermonScripture[]
  topics     SermonTopic[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@index([artist])
  @@index([serviceType])
  @@index([seriesSlug, seriesPart])
  @@map("sermons")
}

/// The 66-book canon. `canonOrder` is the only sort key the scripture index
/// uses: an alphabetical Bible is unusable to anyone who knows it.
model BibleBook {
  slug       String @id
  name       String
  testament  String
  canonOrder Int    @unique @map("canon_order")
  chapters   Int

  sermons SermonScripture[]

  @@map("bible_books")
}

/// Courses and events. Self-referential so the Westminster chapters hang under
/// the confession that heads them.
model Series {
  slug        String  @id
  name        String
  kind        String
  parentSlug  String? @map("parent_slug")
  description String  @default("")
  sermonCount Int     @default(0) @map("sermon_count")

  parent   Series?  @relation("SeriesParent", fields: [parentSlug], references: [slug], onDelete: SetNull)
  children Series[] @relation("SeriesParent")
  sermons  Sermon[]

  @@index([parentSlug])
  @@map("series")
}

/// Two-level taxonomy: the group carries what Desiring God splits into a
/// separate "themes" page, the leaf is the topic. One structure is right for
/// 456 sermons; two would be ceremony.
model Topic {
  slug        String @id
  name        String
  groupSlug   String @map("group_slug")
  groupName   String @map("group_name")
  description String @default("")

  sermons SermonTopic[]

  @@index([groupSlug])
  @@map("topics")
}

/// One row per (sermon, chapter). A lesson on "Gênesis 12-50" covers 39
/// chapters and must be findable from any of them, so ranges are expanded at
/// load time.
///
/// `chapter` is 0, not null, when a title names a book without a chapter
/// ("EBD - 1 Samuel"). A sentinel rather than NULL because the row's identity
/// includes the chapter, and Postgres treats NULLs in a unique index as
/// distinct — two book-level rows for the same sermon would both be allowed.
model SermonScripture {
  sermonId   String  @map("sermon_id")
  bookSlug   String  @map("book_slug")
  chapter    Int     @default(0)
  verseStart Int?    @map("verse_start")
  verseEnd   Int?    @map("verse_end")
  /// 'titulo' or 'transcricao' — kept so a bad extraction pass can be undone
  /// without touching what the titles established.
  source     String  @default("titulo")
  isPrimary  Boolean @default(true) @map("is_primary")

  sermon Sermon    @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  book   BibleBook @relation(fields: [bookSlug], references: [slug], onDelete: Cascade)

  @@id([sermonId, bookSlug, chapter])
  @@index([bookSlug, chapter])
  @@map("sermon_scriptures")
}

model SermonTopic {
  sermonId   String @map("sermon_id")
  topicSlug  String @map("topic_slug")
  confidence Float  @default(1.0)

  sermon Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicSlug], references: [slug], onDelete: Cascade)

  @@id([sermonId, topicSlug])
  @@index([topicSlug])
  @@map("sermon_topics")
}

model SermonChunk {
  id String @id @default(uuid())

  sermonId String @map("sermon_id")
  sermon   Sermon @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  /// Position within the sermon, so results can be ordered and cited.
  chunkIndex Int    @map("chunk_index")
  content    String

  /// sha256 of (sermonId + chunkIndex + content). Makes re-indexing idempotent:
  /// an unchanged chunk is skipped rather than re-embedded.
  contentHash String @map("content_hash")

  /// gemini-embedding-001 truncated 3072 -> 1536 (Matryoshka) and re-normalized.
  /// halfvec halves storage at negligible recall cost; pgvector caps HNSW on
  /// `vector` at 2000 dims, which 1536 respects.
  embedding Unsupported("halfvec(1536)")?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sermonId, chunkIndex])
  @@index([contentHash])
  @@map("sermon_chunks")
}

/// Feedback box from the old server, moved off an append-only text file.
model Suggestion {
  id         String   @id @default(uuid())
  suggestion String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("suggestions")
}
