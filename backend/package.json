{
  "name": "@ipp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:push": "bash scripts/db-push.sh",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "index": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/index-corpus.ts",
    "eval": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/eval-golden.ts",
    "verify:corpus": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/verify-corpus.ts",
    "derive:facets": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/derive-facets.ts",
    "extract:scripture": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/extract-scripture.ts",
    "propose:taxonomy": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/propose-taxonomy.ts",
    "label:topics": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/label-topics.ts",
    "canonicalize:series": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/canonicalize-series.ts",
    "index:facets": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/index-facets.ts",
    "check:spotify": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/check-spotify.ts",
    "verify:facets": "node --experimental-strip-types --env-file-if-exists=../.env src/scripts/verify-facets.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@ipp/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
