{
  "name": "@ipp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:push": "bash scripts/db-push.sh",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "index": "node --experimental-strip-types src/scripts/index-corpus.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@ipp/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
